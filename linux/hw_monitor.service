[Unit]
Description=SmartMonitor Hardware Monitor Service
After=network.target local-fs.target

[Service]
Type=simple

WorkingDirectory=/opt/hw_monitor

# ПРОВЕРКА НАЛИЧИЯ УСТРОЙСТВА ПЕРЕД ЗАПУСКОМ
# Если устройство 0483:0065 не найдено, команда вернет код ошибки 1, 
# и systemd отменит запуск. Благодаря Restart=on-failure, он будет 
# повторять попытку каждые 5 секунд, пока устройство не будет подключено.
ExecStartPre=/bin/sh -c '/usr/bin/lsusb -d 0483:0065 >/dev/null 2>&1 || exit 1'

# Запрещаем Python создавать __pycache__ и .pyc файлы
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/usr/bin/python3 -B /opt/hw_monitor/monitor.py

# Автоматический перезапуск при падении (например, если отключили USB)
Restart=on-failure
RestartSec=5

# Перенаправление вывода в системный журнал (journalctl)
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
